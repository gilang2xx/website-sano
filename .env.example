# Lead notification email (server-side, /api/lead.ts) — this is the actual
# delivery mechanism for leads. Uses Resend (https://resend.com), free tier
# covers small volume. Sign up, get an API key from the dashboard.
RESEND_API_KEY=

# Where lead notification emails are sent (your inbox).
LEAD_NOTIFICATION_EMAIL=sanocareofficial@gmail.com

# Sender address. Without a verified domain in Resend, you can only send from
# onboarding@resend.dev (works out of the box, fine for launch). Once you
# verify your own domain in Resend, switch this to e.g. leads@sanomatrassehat.com
RESEND_FROM_EMAIL=onboarding@resend.dev

# Meta Conversions API (server-side, /api/lead.ts)
# Dataset ID from Meta Events Manager > Data Sources > this dataset > Settings
META_DATASET_ID=

# System User access token with ads_management permission for the dataset above
# Generate in Meta Business Settings > Users > System Users
META_ACCESS_TOKEN=

# Optional: set while testing so events show up under Events Manager > Test Events
# instead of counting as live production events. Remove/unset for production.
META_TEST_EVENT_CODE=

# Configurable lead value sent in custom_data (never trusted from the client).
# Currency code for custom_data.value (ISO 4217). Defaults to IDR if unset.
META_LEAD_CURRENCY=IDR

# Fallback numeric value (in META_LEAD_CURRENCY) used when a service_type has
# no entry in META_LEAD_VALUE_MAP, or the map is unset/invalid. Defaults to 50000.
META_LEAD_DEFAULT_VALUE=50000

# Optional per-service_type override, as a JSON object string.
# Example: {"klinik_matras":150000,"klinik_sofa":100000,"sano_clean":75000}
META_LEAD_VALUE_MAP=
