{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/(layanan|pricelist|artikel|tentang-kami|before-after|kontak|klinik-matras|klinik-sofa|sano-clean|kebijakan-privasi)/",
      "destination": "/$1",
      "permanent": true
    },
    {
      "source": "/artikel/:slug/",
      "destination": "/artikel/:slug",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/admin/",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/admin/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/api/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
